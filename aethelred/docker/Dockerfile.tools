# Aethelred Tools Dockerfile
FROM rust:1.70-alpine as builder

# Install build dependencies
RUN apk add --no-cache \
    build-base \
    openssl-dev \
    pkgconfig \
    musl-dev

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY node ./node
COPY contracts ./contracts

# Build the tools
RUN cargo build --release --bin aethelred-node

# Runtime stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    libgcc \
    curl

# Copy the binary
COPY --from=builder /app/target/release/aethelred-node /usr/local/bin/aethelred-node

# Create app directory
RUN mkdir -p /app/data /app/config /app/test-data

WORKDIR /app

# Default command for task submission
CMD ["sh", "-c", "while true; do aethelred-node submit-test-task && sleep ${SUBMISSION_INTERVAL:-60}; done"]