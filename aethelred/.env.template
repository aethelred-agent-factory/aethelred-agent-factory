# Aethelred Protocol Deployment Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# =============================================================================
# WALLET CONFIGURATION (REQUIRED)
# =============================================================================

# Your private key for deployment (64 hex characters with 0x prefix)
# Example: 0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
PRIVATE_KEY=

# Your wallet address (for verification purposes)
# Example: 0x742d35Cc6639C0532fE3060F0B6754515EB24697
DEPLOYER_ADDRESS=

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Network selection (leave as arbitrum-sepolia for testnet)
NETWORK=arbitrum-sepolia

# RPC URL (default for Arbitrum Sepolia)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Chain ID (421614 for Arbitrum Sepolia)
CHAIN_ID=421614

# Block explorer URL
EXPLORER_URL=https://sepolia.arbiscan.io

# =============================================================================
# TOKEN CONFIGURATION
# =============================================================================

# Initial AETHEL token supply (without decimals)
# Example: 1000000 = 1 million tokens
INITIAL_SUPPLY=1000000

# Token name
TOKEN_NAME=Aethelred Token

# Token symbol
TOKEN_SYMBOL=AETHEL

# Token decimals (18 is standard)
TOKEN_DECIMALS=18

# =============================================================================
# PROTOCOL PARAMETERS
# =============================================================================

# Minimum stake required to become an executor (in AETHEL tokens)
MIN_EXECUTOR_STAKE=1000

# Challenge period duration in seconds (7200 = 2 hours)
CHALLENGE_PERIOD=7200

# Default bond amount for tasks (in AETHEL tokens)
DEFAULT_TASK_BOND=100

# Default challenge bond (in AETHEL tokens)
DEFAULT_CHALLENGE_BOND=200

# Quality score threshold (0-100, 70 = 70%)
QUALITY_THRESHOLD=70

# Maximum number of bisection rounds in disputes
MAX_BISECTION_ROUNDS=20

# Maximum number of quality assessors per task
MAX_QUALITY_ASSESSORS=5

# Quality assessment timeout (in seconds, 3600 = 1 hour)
QUALITY_ASSESSMENT_TIMEOUT=3600

# =============================================================================
# PROJECT INFORMATION (OPTIONAL - for documentation)
# =============================================================================

# Your project name
PROJECT_NAME=

# Your name or organization
DEPLOYER_NAME=

# Contact email
CONTACT_EMAIL=

# Project description
PROJECT_DESCRIPTION=

# =============================================================================
# NODE CONFIGURATION (for post-deployment setup)
# =============================================================================

# Preferred node roles (comma-separated)
# Options: executor,verifier,finalizer,assessor
NODE_ROLES=executor,verifier,finalizer,assessor

# Maximum concurrent tasks for executor
MAX_CONCURRENT_TASKS=3

# Verification probability for verifier (0.0 to 1.0)
VERIFICATION_PROBABILITY=0.1

# Data directory for node
NODE_DATA_DIR=~/.aethelred/data

# Log directory for node
NODE_LOG_DIR=~/.aethelred/logs

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# ADVANCED CONFIGURATION (optional - use defaults if unsure)
# =============================================================================

# Gas price in gwei (leave empty for automatic)
GAS_PRICE=

# Gas limit multiplier (1.0 = 100%, 1.2 = 120%)
GAS_LIMIT_MULTIPLIER=1.2

# Transaction timeout in seconds
TX_TIMEOUT=300

# Number of confirmation blocks to wait
CONFIRMATIONS=2

# Retry attempts for failed transactions
MAX_RETRIES=3

# =============================================================================
# MARKETPLACE CONFIGURATION
# =============================================================================

# Whether to populate marketplace with Hugging Face models after deployment
POPULATE_MARKETPLACE=true

# Default model usage fee (in AETHEL tokens)
DEFAULT_MODEL_FEE=10

# Number of models to register initially
INITIAL_MODEL_COUNT=28